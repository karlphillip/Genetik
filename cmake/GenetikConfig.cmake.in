@PACKAGE_INIT@
set(Genetik_VERSION "@PROJECT_VERSION@")
set(Genetik_FOUND TRUE)
foreach(component IN LISTS Genetik_FIND_COMPONENTS)
    set(Genetik_${component}_FOUND FALSE)
endforeach()
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(NOT TARGET Genetik::Genetik)
    include("${CMAKE_CURRENT_LIST_DIR}/GenetikTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/GenetikFloatingPoint.cmake")
    genetik_require_floating_point(Genetik::Genetik FALSE)
endif()

# Opt in with find_package(Genetik COMPONENTS ScientificNumerics).
if("ScientificNumerics" IN_LIST Genetik_FIND_COMPONENTS)
    include("${CMAKE_CURRENT_LIST_DIR}/GenetikScientificNumerics.cmake")
    set(Genetik_ScientificNumerics_FOUND TRUE)
endif()

check_required_components(Genetik)
if(NOT Genetik_FOUND)
    set(Genetik_NOT_FOUND_MESSAGE "unsupported Genetik component; available component: ScientificNumerics")
    return()
endif()
