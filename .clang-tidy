Checks: >-
  -*,
  bugprone-sizeof-expression,
  bugprone-suspicious-missing-comma,
  bugprone-use-after-move,
  performance-move-const-arg,
  performance-unnecessary-value-param,
  readability-container-size-empty,
  readability-simplify-boolean-expr
WarningsAsErrors: ''
HeaderFilterRegex: '.*/genetik/(Expression|ExpressionDerivative|ExpressionSecondDerivative|PhysicalDimensions|Regression|SymbolicAlgebra|TypedExpression|TypedExpressionParsing|TypedVariation)\.hpp$|.*/genetik/detail/(ScalarOperators|ExpressionParser)\.hpp$'
FormatStyle: file
