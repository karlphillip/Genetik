file(REMOVE_RECURSE "${WORKSPACE}")
execute_process(COMMAND "${CAMPAIGN}" --smoke --threads 2 --output "${WORKSPACE}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Integral campaign smoke failed: ${output} ${error}")
endif()
foreach(name PROTOCOL.txt training.csv search.txt assessment.txt fitting.txt)
    if(NOT EXISTS "${WORKSPACE}/${name}")
        message(FATAL_ERROR "Missing bounded campaign output: ${name}")
    endif()
endforeach()
execute_process(COMMAND "${CAMPAIGN}" --threads 0 --output "${WORKSPACE}/invalid" RESULT_VARIABLE status)
if(status EQUAL 0 OR EXISTS "${WORKSPACE}/invalid")
    message(FATAL_ERROR "Invalid execution setting accepted or output created before validation")
endif()
