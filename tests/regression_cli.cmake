file(MAKE_DIRECTORY "${WORKSPACE}")
execute_process(COMMAND "${GENERATOR}" --generate "${WORKSPACE}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "generator failed: ${error}")
endif()
set(args --inputs first,second --target target --seed 42 --loss-budget 64 --no-fit)
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${args}
    --evaluate "${WORKSPACE}/interior.csv" --evaluate "${WORKSPACE}/exterior.csv"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "file search failed: ${error}")
endif()
foreach(expected "dimensions=2" "x0=first" "x1=second" "training_loss_attempts=64" "unused_allowance=0" "stop=evaluation_budget" "reporting_prediction_rows=25" "postsearch_evaluation_loss_calls=1")
    string(FIND "${output}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "missing CLI evidence ${expected}: ${output}")
    endif()
endforeach()
string(FIND "${output}" "selection_finalized" selected)
string(FIND "${output}" "evaluation_file=" evaluated)
if(selected EQUAL -1 OR evaluated LESS selected)
    message(FATAL_ERROR "evaluation occurred before selection")
endif()
string(REGEX MATCH "nodes=[^\n]+" with_evaluation "${output}")
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(REGEX MATCH "nodes=[^\n]+" training_only "${output}")
if(NOT result EQUAL 0 OR NOT training_only STREQUAL with_evaluation)
    message(FATAL_ERROR "evaluation paths changed selected expression")
endif()
# Valid prefix followed by invalid data must fail before starting any search.
file(WRITE "${WORKSPACE}/bad.csv" "first,second,target\n1,2,3\n4,5,6junk\n")
foreach(where training evaluation)
    if(where STREQUAL training)
        set(path "${WORKSPACE}/bad.csv")
        set(extra)
    else()
        set(path "${WORKSPACE}/training.csv")
        set(extra --evaluate "${WORKSPACE}/bad.csv")
    endif()
    execute_process(COMMAND "${SEARCH}" "${path}" ${args} ${extra}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR output MATCHES "search_start" OR NOT error MATCHES "bad.csv:row 3:column 3:")
        message(FATAL_ERROR "bad ${where} file was not rejected before search: ${output} ${error}")
    endif()
endforeach()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" --inputs first,first --target target --seed 42 --loss-budget 64
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR output MATCHES "search_start")
    message(FATAL_ERROR "repeated selected column accepted")
endif()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" --inputs first,second --target target --seed 4294967296 --loss-budget 64
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR output MATCHES "search_start")
    message(FATAL_ERROR "invalid seed accepted")
endif()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" --inputs first,second --target target --seed 0 --loss-budget -1
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR output MATCHES "search_start")
    message(FATAL_ERROR "invalid budget accepted")
endif()
# These are observations of the everywhere-defined LINEAR target ln(2)*(x-1).
# A log model also fits these training observations, but fails on evaluation.
# The CLI smoke is quality-agnostic; deterministic reporting tests construct that model.
# No labels of the generating log/div campaign are fabricated at undefined points.
file(WRITE "${WORKSPACE}/linear-observations.csv" "first,target\n1,0\n2,0.6931471805599453\n")
file(WRITE "${WORKSPACE}/linear-evaluation.csv" "first,target\n1,0\n0,-0.6931471805599453\n-1,-1.3862943611198906\n2,0.6931471805599453\n")
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/linear-observations.csv" --inputs first --target target --seed 42 --loss-budget 64 --no-fit
    --operators log --evaluate "${WORKSPACE}/linear-evaluation.csv"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "unary-only file workflow failed: ${output} ${error}")
endif()
foreach(expected "operators=log operator_selection=uniform_over_structurally_feasible_entries" "selection_finalized" "invalid_predictions_total=" "reporting_loss_rows=" "reporting_prediction_rows=4")
    string(FIND "${output}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "missing expanded workflow evidence ${expected}: ${output}")
    endif()
endforeach()
foreach(operators IN ITEMS "" "add,,log" "div,div" "tangent")
    execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${args} --operators "${operators}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR output MATCHES "search_start")
        message(FATAL_ERROR "invalid operators accepted: ${operators}")
    endif()
endforeach()

# New cadence option: omitted and explicit one must preserve the same observable run.
execute_process(COMMAND "${GENERATOR}" --arithmetic --generate "${WORKSPACE}/cadence" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "cadence fixture generation: ${error}")
endif()
set(cadence_args --inputs first,second --target target --seed 42 --loss-budget 64 --no-fit --operators add,sub,mul,div,log)
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/cadence/training.csv" ${cadence_args} RESULT_VARIABLE result OUTPUT_VARIABLE omitted ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "default cadence: ${error}")
endif()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/cadence/training.csv" ${cadence_args} --fit-every 1 RESULT_VARIABLE result OUTPUT_VARIABLE explicit ERROR_VARIABLE error)
string(REGEX REPLACE "seconds=[^ \n]+" "seconds=TIME" omitted "${omitted}")
string(REGEX REPLACE "seconds=[^ \n]+" "seconds=TIME" explicit "${explicit}")
if(NOT result EQUAL 0 OR NOT omitted STREQUAL explicit)
    message(FATAL_ERROR "omitted/explicit-one cadence differs: ${error}")
endif()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/cadence/training.csv" ${cadence_args} --fit-every 4 RESULT_VARIABLE result OUTPUT_VARIABLE cadence ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT cadence MATCHES "fit_every=4" OR NOT cadence MATCHES "schedule_skips=0")
    message(FATAL_ERROR "disabled-fitting interval-four workflow failed: ${cadence} ${error}")
endif()
string(REGEX REPLACE "seconds=[^ \n]+" "seconds=TIME" cadence "${cadence}")
string(REPLACE "fit_every=4" "fit_every=1" cadence "${cadence}")
if(NOT cadence STREQUAL omitted)
    message(FATAL_ERROR "cadence changed disabled-fitting results")
endif()
# Enabled fitting smoke stays short under ASan; full scheduled evolution is checked
# by C++ fixtures and the separately recorded Release file/in-memory reproduction.
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/cadence/training.csv" --inputs first,second --target target --seed 42
    --loss-budget 128 --operators add,sub,mul,div,log --fit-every 4 RESULT_VARIABLE result OUTPUT_VARIABLE enabled ERROR_VARIABLE error)
if((NOT result EQUAL 0 AND NOT result EQUAL 2) OR NOT enabled MATCHES "fitting=1 fit_every=4" OR NOT enabled MATCHES "stop=evaluation_budget")
    message(FATAL_ERROR "short fitting-enabled cadence workflow failed: ${enabled} ${error}")
endif()
foreach(bad "0" "-1" "nan" "1.5" "1junk" "18446744073709551616")
    execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/cadence/training.csv" ${cadence_args} --fit-every "${bad}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(result EQUAL 0 OR out MATCHES "search_start")
        message(FATAL_ERROR "bad cadence accepted: ${bad}")
    endif()
endforeach()

# Explicit one preserves omitted mode; parallel requests execute a bounded search.
set(parallel_args --inputs first,second --target target --seed 42 --loss-budget 64 --no-fit)
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${parallel_args} --threads 1 RESULT_VARIABLE status OUTPUT_VARIABLE one)
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${parallel_args} --threads 3 RESULT_VARIABLE parallel_status OUTPUT_VARIABLE parallel)
string(REGEX MATCH "nodes=[^\n]+" one_model "${one}")
string(REGEX MATCH "nodes=[^\n]+" parallel_model "${parallel}")
if(NOT status EQUAL 0 OR NOT parallel_status EQUAL 0 OR NOT one_model STREQUAL parallel_model OR NOT one_model STREQUAL training_only OR NOT parallel MATCHES "threads_requested=3 threads_effective=3")
    message(FATAL_ERROR "parallel CLI reproduction failed: ${one} ${parallel}")
endif()
foreach(threads IN ITEMS 0 -1 +2 257 99999999999999999999 junk)
    execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${parallel_args} --threads "${threads}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 1 OR output MATCHES "search_start")
        message(FATAL_ERROR "invalid threads value accepted: ${threads}: ${output} ${error}")
    endif()
endforeach()

# A flag-looking column name is still a value of --inputs, not an execution flag.
file(WRITE "${WORKSPACE}/flag-column.csv" "--threads,target\n0,1\n1,2\n")
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/flag-column.csv" --inputs --threads --target target --seed 42 --loss-budget 64 --no-fit --threads 2
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "x0=--threads" OR NOT output MATCHES "threads_requested=2 threads_effective=2")
    message(FATAL_ERROR "flag-looking input name misparsed: ${output} ${error}")
endif()

execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" --inputs first,second --target target --seed 2 --loss-budget 32 --no-fit --discrete-only --population 8 --nodes 15 --depth 5 --operators add,mul,sin,cos,exp,sqrt,powi --exponents 0,2,8 --threads 2 RESULT_VARIABLE result OUTPUT_VARIABLE scientific ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT scientific MATCHES "exponents=0,2,8" OR NOT scientific MATCHES "search_start")
    message(FATAL_ERROR "scientific CLI failed: ${scientific} ${error}")
endif()
foreach(exponents IN ITEMS "" "-1" "9" "2,2" "1.5" "0,,2" "0,2," "999999999999999999999")
    execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${args} --exponents "${exponents}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR output MATCHES "search_start")
        message(FATAL_ERROR "invalid exponent configuration started search: ${exponents}")
    endif()
endforeach()
