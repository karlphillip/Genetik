file(REMOVE_RECURSE "${WORKSPACE}")
execute_process(COMMAND "${CAMPAIGN}" --threads 2 --smoke --output "${WORKSPACE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "threads_requested=2 threads_effective=2" OR NOT EXISTS "${WORKSPACE}/search.txt")
    message(FATAL_ERROR "template campaign failed: ${output} ${error}")
endif()
file(READ "${WORKSPACE}/search.txt" search)
file(READ "${WORKSPACE}/fitting.txt" fitting)
if(NOT search MATCHES "models_frozen representative_seed=" OR NOT search MATCHES "hole=" OR NOT fitting MATCHES "loss=0")
    message(FATAL_ERROR "missing frozen models/fitting evidence: ${search} ${fitting}")
endif()
foreach(value 0 -1 257 999999999999999999999999999)
    execute_process(COMMAND "${CAMPAIGN}" --threads "${value}" --smoke --output "${WORKSPACE}/bad" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0 OR EXISTS "${WORKSPACE}/bad")
        message(FATAL_ERROR "unsupported threads accepted before search")
    endif()
endforeach()
