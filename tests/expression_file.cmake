file(MAKE_DIRECTORY "${WORKSPACE}")
file(WRITE "${WORKSPACE}/training.csv" "target,second,first\r\n-3,2,1\r\n0,1,2\r\n")
file(WRITE "${WORKSPACE}/expression.txt" "x0-2*x1\r\n")
execute_process(COMMAND "${EVALUATE}" "${WORKSPACE}/training.csv" --expression "${WORKSPACE}/expression.txt" --inputs first,second --target target RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "mse=0" OR NOT output MATCHES "x0=first training_file_column=3" OR NOT output MATCHES "evolution=false" OR output MATCHES "search_start")
    message(FATAL_ERROR "formula evaluation: ${status} ${output} ${error}")
endif()
file(WRITE "${WORKSPACE}/fit.csv" "x,y\n-1,-1.75\n0,0\n1,1.75\n")
file(WRITE "${WORKSPACE}/evaluation.csv" "x,y\n2,3.5\n")
file(WRITE "${WORKSPACE}/expression.txt" "1*x0")
execute_process(COMMAND "${EVALUATE}" "${WORKSPACE}/fit.csv" --expression "${WORKSPACE}/expression.txt" --inputs x --target y --fit --fit-budget 128 --evaluate "${WORKSPACE}/evaluation.csv" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "improved=1" OR NOT output MATCHES "finalized_expression=\\(1.75 \\* x0\\)" OR NOT output MATCHES "mse=0")
    message(FATAL_ERROR "explicit fitting: ${output} ${error}")
endif()
file(WRITE "${WORKSPACE}/expression.txt" "log(x0)")
file(WRITE "${WORKSPACE}/evaluation.csv" "x,y\n0,1\n1,0\n-1,2\n")
execute_process(COMMAND "${EVALUATE}" "${WORKSPACE}/evaluation.csv" --expression "${WORKSPACE}/expression.txt" --inputs x --target y RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 0 OR NOT output MATCHES "mse=invalid" OR NOT output MATCHES "prediction_rows=3 invalid_predictions_total=2")
    message(FATAL_ERROR "all-row invalidity: ${output} ${error}")
endif()
foreach(bad "-x0" "x9" "1 trailing" "powi(x0,9)")
    file(WRITE "${WORKSPACE}/expression.txt" "${bad}")
    execute_process(COMMAND "${EVALUATE}" "${WORKSPACE}/fit.csv" --expression "${WORKSPACE}/expression.txt" --inputs x --target y RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(status EQUAL 0 OR NOT error MATCHES "expression.txt: parse_category=.*expression byte" OR output MATCHES "finalized_expression")
        message(FATAL_ERROR "malformed expression file silently accepted: ${bad} ${output} ${error}")
    endif()
endforeach()
execute_process(COMMAND "${EVALUATE}" "${WORKSPACE}/fit.csv" --expression "${WORKSPACE}/missing.txt" --inputs x --target y RESULT_VARIABLE status ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "cannot open expression")
    message(FATAL_ERROR "missing expression file accepted")
endif()
string(REPEAT " " 1048576 full)
file(WRITE "${WORKSPACE}/expression.txt" "${full}1")
execute_process(COMMAND "${EVALUATE}" "${WORKSPACE}/fit.csv" --expression "${WORKSPACE}/expression.txt" --inputs x --target y RESULT_VARIABLE status ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "byte limit")
    message(FATAL_ERROR "oversized expression file accepted")
endif()
