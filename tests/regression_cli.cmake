file(MAKE_DIRECTORY "${WORKSPACE}")
execute_process(COMMAND "${GENERATOR}" --generate "${WORKSPACE}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "generator failed: ${error}")
endif()
set(args --inputs first,second --target target --seed 42 --loss-budget 64 --no-fit)
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${args}
    --evaluate "${WORKSPACE}/interior.csv" --evaluate "${WORKSPACE}/exterior.csv"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "file search failed: ${error}")
endif()
foreach(expected "dimensions=2" "x0=first" "x1=second" "training_loss_attempts=64" "unused_allowance=0" "stop=evaluation_budget" "reporting_prediction_rows=25" "postsearch_evaluation_loss_calls=1")
    string(FIND "${output}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "missing CLI evidence ${expected}: ${output}")
    endif()
endforeach()
string(FIND "${output}" "selection_finalized" selected)
string(FIND "${output}" "evaluation_file=" evaluated)
if(selected EQUAL -1 OR evaluated LESS selected)
    message(FATAL_ERROR "evaluation occurred before selection")
endif()
string(REGEX MATCH "nodes=[^\n]+" with_evaluation "${output}")
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(REGEX MATCH "nodes=[^\n]+" training_only "${output}")
if(NOT result EQUAL 0 OR NOT training_only STREQUAL with_evaluation)
    message(FATAL_ERROR "evaluation paths changed selected expression")
endif()
# Valid prefix followed by invalid data must fail before starting any search.
file(WRITE "${WORKSPACE}/bad.csv" "first,second,target\n1,2,3\n4,5,6junk\n")
foreach(where training evaluation)
    if(where STREQUAL training)
        set(path "${WORKSPACE}/bad.csv")
        set(extra)
    else()
        set(path "${WORKSPACE}/training.csv")
        set(extra --evaluate "${WORKSPACE}/bad.csv")
    endif()
    execute_process(COMMAND "${SEARCH}" "${path}" ${args} ${extra}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR output MATCHES "search_start" OR NOT error MATCHES "bad.csv:row 3:column 3:")
        message(FATAL_ERROR "bad ${where} file was not rejected before search: ${output} ${error}")
    endif()
endforeach()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" --inputs first,first --target target --seed 42 --loss-budget 64
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR output MATCHES "search_start")
    message(FATAL_ERROR "repeated selected column accepted")
endif()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" --inputs first,second --target target --seed 4294967296 --loss-budget 64
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR output MATCHES "search_start")
    message(FATAL_ERROR "invalid seed accepted")
endif()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/training.csv" --inputs first,second --target target --seed 0 --loss-budget -1
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR output MATCHES "search_start")
    message(FATAL_ERROR "invalid budget accepted")
endif()
