file(MAKE_DIRECTORY "${WORKSPACE}")
execute_process(COMMAND "${PRIME}" --generate --output "${WORKSPACE}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "prime generation: ${error}")
endif()
execute_process(COMMAND "${PRIME}" --generate --output "${WORKSPACE}" --prime-file "${WORKSPACE}/first-1000.txt" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "owned prefix validation: ${error}")
endif()
file(WRITE "${WORKSPACE}/wrong.txt" "2\n5\n")
execute_process(COMMAND "${PRIME}" --generate --output "${WORKSPACE}" --prime-file "${WORKSPACE}/wrong.txt" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "exactly 1000")
    message(FATAL_ERROR "incorrect prefix accepted: ${out} ${error}")
endif()
execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/fitting.csv" --inputs u --target v --seed 42 --loss-budget 64 --loss-threshold 0 --no-fit --operators add,sub,mul,div,log --evaluate "${WORKSPACE}/extrapolation.csv" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "normalized file workflow: ${error}")
endif()
foreach(expected "training_rows=1000 dimensions=1" "x0=u" "training_loss_attempts=64" "training_threshold=0" "selection_finalized" "reporting_prediction_rows=200")
    string(FIND "${out}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "missing ${expected}: ${out}")
    endif()
endforeach()
foreach(bad "nan" "-1" "1junk")
    execute_process(COMMAND "${SEARCH}" "${WORKSPACE}/fitting.csv" --inputs u --target v --seed 42 --loss-budget 64 --loss-threshold "${bad}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error)
    if(result EQUAL 0 OR out MATCHES "search_start")
        message(FATAL_ERROR "bad threshold started search: ${bad}")
    endif()
endforeach()
