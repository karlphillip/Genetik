if(NOT WORKSPACE OR NOT SEARCH)
    message(FATAL_ERROR "typed CLI fixture requires workspace/executable")
endif()
file(REMOVE_RECURSE "${WORKSPACE}")
execute_process(COMMAND "${SEARCH}" --smoke --fit --threads 2 --output "${WORKSPACE}/search" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "typed search failed: ${output} ${diagnostics}")
endif()
execute_process(COMMAND "${SEARCH}" --fit-fixture --output "${WORKSPACE}/fit" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "typed fit failed: ${output} ${diagnostics}")
endif()
file(READ "${WORKSPACE}/fit/results.txt" evidence)
if(NOT evidence MATCHES "coefficients=8" OR NOT evidence MATCHES "max_error=0")
    message(FATAL_ERROR "typed coefficient fixture failed: ${evidence}")
endif()
execute_process(COMMAND "${SEARCH}" --threads 0 --output "${WORKSPACE}/bad" RESULT_VARIABLE result)
if(result EQUAL 0 OR EXISTS "${WORKSPACE}/bad/results.txt")
    message(FATAL_ERROR "malformed execution configuration started search")
endif()
